{
  "output_dir": "revision_outputs/fpn_single_ignition",
  "protocol_status": "draft_not_frozen",
  "synthetic": false,
  "device": "cuda",
  "seed": 2026,
  "dataset_dir": "fpn_ignition_dataset",
  "allow_draft_labels": true,
  "split_policy": "recording_disjoint",
  "temporal_purge_frames": 50,
  "epochs": 10,
  "batch_size": 2,
  "num_workers": 0,
  "learning_rate": 0.005,
  "model": {
    "backbone": "resnet18",
    "trainable_layers": 5,
    "anchor_sizes": [
      4,
      8,
      16,
      32,
      64
    ],
    "min_size": 896,
    "max_size": 1280,
    "box_detections_per_img": 300,
    "box_score_thresh": 0.001,
    "box_nms_thresh": 0.5,
    "backbone_weights": null,
    "num_classes": 2,
    "ignore_regions": true,
    "ignore_ioa": 0.5,
    "keep_original_resolution": true
  }
}
